{
  "info": {
    "name": "nl2sql (Java) REST API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Natural-language-to-SQL REST API.\n\nSet the collection variables `baseUrl` (default http://127.0.0.1:8080) and `apiKey` (NL2SQL_SERVER_API_KEY; leave empty if the server has no key). Every /v1 request sends it as the X-API-Key header.\n\nRun **Ask** before **Ask follow-up**: the follow-up sends the previous question and SQL as history."
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "apiKey",
      "value": ""
    },
    {
      "key": "lastQuestion",
      "value": ""
    },
    {
      "key": "lastSql",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Service",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Liveness check. No API key needed.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Index",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": []
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "OpenAPI spec",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/openapi.yaml",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "openapi.yaml"
              ]
            },
            "description": "Full API contract (OpenAPI 3).",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/info",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "info"
              ]
            },
            "description": "Connected database, type, schema, table count, version. Quick way to check the database connection."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Schema",
      "item": [
        {
          "name": "Get schema",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/schema",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "schema"
              ]
            },
            "description": "Tables and columns visible to the model."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh schema",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/schema/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "schema",
                "refresh"
              ]
            },
            "description": "Re-read the schema after database changes."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Questions",
      "item": [
        {
          "name": "Ask",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/ask",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "ask"
              ]
            },
            "description": "Question -> SQL -> rows.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"How many shipments are in transit?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"SQL generated\", () => pm.expect(r.sql, r.error || r.clarification).to.be.a(\"string\"));",
                  "if (r.sql) { pm.collectionVariables.set(\"lastQuestion\", r.question); pm.collectionVariables.set(\"lastSql\", r.sql); }",
                  "console.log(r.sql); console.log(r.columns, r.rows);"
                ]
              }
            }
          ]
        },
        {
          "name": "Ask follow-up (with history)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/ask",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "ask"
              ]
            },
            "description": "Follow-up question: sends the previous question and SQL (saved by **Ask**) as history.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Break that down by carrier\",\n  \"history\": [\n    {\n      \"question\": \"{{lastQuestion}}\",\n      \"sql\": \"{{lastSql}}\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"SQL generated\", () => pm.expect(r.sql, r.error || r.clarification).to.be.a(\"string\"));",
                  "if (r.sql) { pm.collectionVariables.set(\"lastQuestion\", r.question); pm.collectionVariables.set(\"lastSql\", r.sql); }",
                  "console.log(r.sql); console.log(r.columns, r.rows);"
                ]
              }
            }
          ]
        },
        {
          "name": "Generate SQL only",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/generate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "generate"
              ]
            },
            "description": "Question -> validated SQL, not executed.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Top 5 customers by total freight cost last quarter\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Examples",
      "item": [
        {
          "name": "Add example",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/examples",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "examples"
              ]
            },
            "description": "Store a verified question/SQL pair used as a few-shot example. The SQL is validated first, so table and column names must exist in your database.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"How many shipments were delivered late?\",\n  \"sql\": \"SELECT COUNT(*) FROM shipments WHERE delivered_at > promised_delivery_at\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Guardrail and error checks",
      "item": [
        {
          "name": "Rejected: destructive SQL as example",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/examples",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "examples"
              ]
            },
            "description": "Must be refused with 400.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"x\",\n  \"sql\": \"DROP TABLE shipments\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Rejected: destructive question",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/ask",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "ask"
              ]
            },
            "description": "The data must not change: expect a refusal, a clarification, or at most a SELECT.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Delete all cancelled shipments\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"only read-only SQL\", () => { if (r.sql) pm.expect(r.sql.trim().toUpperCase()).to.match(/^(SELECT|WITH)/); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Missing question",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/ask",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "ask"
              ]
            },
            "description": "400 Bad Request.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Wrong API key",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "wrong-key"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/info",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "info"
              ]
            },
            "description": "401 when the server has an API key.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}